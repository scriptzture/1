<script>
(()=>{
'use strict';
const T=THREE;
if(!T){document.body.insertAdjacentHTML('beforeend','<p style="position:fixed;inset:40%;color:#fff">3D engine failed to load. Reload the page.</p>');return}

/* ================= helpers ================= */
const clamp=(v,a,b)=>v<a?a:v>b?b:v, lerp=(a,b,t)=>a+(b-a)*t;
