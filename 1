    if(n!==lastBeep&&n>=1&&n<=3){lastBeep=n;el.textContent=n;el.className='';el.style.opacity=1;AU.tone(440,.18,'square',.14);LIGHTS[3-n].material.color.setHex(0xff3a2a)}
    readInput(player.inp);racers.forEach(r=>{if(!r.isPlayer){r.inp.thr=1;r.inp.steer=0}r.thrVis=lerp(r.thrVis,r.inp.thr,.1)});
    AU.engine(player.inp.thr*.35,false,true);
    if(G.cd<=.6){G.mode='race';el.textContent='GO';el.className='go';AU.tone(880,.5,'square',.18);LIGHTS.forEach(l=>l.material.color.setHex(0x4fff7a));racers.forEach(r=>{r.v=r.isPlayer?(player.inp.thr>0?22:6):15+Math.random()*8})}}
  else if(G.mode==='race'||G.mode==='done'){
    if(G.mode==='race'){G.raceTime+=dt;const c=$('count');if(c.style.opacity>0)c.style.opacity=Math.max(0,c.style.opacity-dt*1.5)}
    if(player.auto)aiInput(player,dt);else readInput(player.inp);
    const pp=player.progress();
    for(const r of racers){let dr=0;if(r.state==='race')for(const o of racers){if(o===r||o.state!=='race')continue;const ds=dS(o.s,r.s);if(ds>7&&ds<50&&Math.abs(o.x-r.x)<3.6&&Math.abs(o.alt-r.alt)<3){dr=1;break}}r.draft=lerp(r.draft,dr,1-Math.exp(-(dr?2.5:5)*dt))}
    for(const r of racers){if(r.isPlayer)continue;const gap=pp-r.progress();r.rubber=(1+clamp(gap/1500,-1,1)*(gap>0?G.diff.up:G.diff.down))*r.skill;if(r.finished)r.rubber=.85;aiInput(r,dt)}
    player.rubber=1;
    {const bOn=player.state==='race'&&(player.boosting||player.padT>0);if(bOn&&!G.bWas&&G.mode==='race'){G.bKick=player.boosting?1:.75;G.shake=Math.max(G.shake,.22);AU.boostKick(G.bKick)}G.bWas=bOn;
     G.bKick=Math.max(0,G.bKick-dt*2.4);G.bLev=lerp(G.bLev,bOn?1:0,1-Math.exp(-(bOn?7:3)*dt));AU.rush(player.state==='race'?clamp(player.v/player.st.top,0,1.4)**2*(.05+G.bLev*.1):0)}
    if(G.elim&&G.mode==='race'){G.elimT-=dt;const act=racers.filter(q=>!q.out&&!q.finished);
      if(G.elimT<=3.05&&G.elimT>0&&act.length>1){const n=Math.ceil(G.elimT);if(n!==G.elimBeep){G.elimBeep=n;AU.tone(n===1?880:660,.09,'square',.1)}}
      if(G.elimT<=0){G.elimT=G.elimInt;G.elimBeep=0;if(act.length>1&&!racers.some(q=>q.finished&&!q.out)){const last=act.reduce((a,b)=>b.progress()<a.progress()?b:a);eliminate(last,act.length-1)}}}
    const sub=Math.ceil(dt/.008),h=dt/sub;for(let k=0;k<sub;k++){for(const r of racers)stepRacer(r,h);contacts()}
    for(const r of racers)if(!r.finished&&r.lap>=G.laps){r.finished=true;r.finishTime=G.raceTime}
    if(G.mode==='done'){G.raceTime+=dt;if(!G.resultsShown&&G.time-G.finishedAt>2.6)showResults()}
    AU.scrape(player.state==='race'?player.scrape:0,player.v)}
  for(const r of racers)placeRacer(r,dt);
  if(G.mode!=='menu')updateHUD(dt);else if(bannerT>0){bannerT-=dt;if(bannerT<=0)$('banner').style.opacity=0}
  // lighting dips inside tunnels
  const inT=(player?frameAt(player.s,FD).ty===2:TITLE.on&&frameAt(TITLE.s,FD).ty===2);hemi.intensity=lerp(hemi.intensity,(inT?LIGHT.hemi*.16:LIGHT.hemi)+G.flash*(inT?.15:2.2),1-Math.exp(-(G.flash>.05?30:4)*dt));sun.intensity=lerp(sun.intensity,inT?LIGHT.sun*.03:LIGHT.sun,1-Math.exp(-4*dt));fill.intensity=lerp(fill.intensity,inT?LIGHT.fill*.2:LIGHT.fill,1-Math.exp(-4*dt));
  if(TRK.pal.rain&&dt>0)updateRain(dt);G.flash=Math.max(0,G.flash-dt*3.2);$('flash').style.opacity=G.flash*.35;
  padChevTex.offset.y=-((G.time*1.8)%1);
  for(const a of ANIM){if(a.userData.f)a.userData.f(a,dt);else a.rotation.z+=dt*a.userData.spd}
  if(TRK.pal.snow&&dt>0&&(!TRK.pal.snowAbove||camera.position.y>TRK.pal.snowAbove)){for(let k=0;k<5;k++){ep.set(camera.position.x+(Math.random()-.5)*110,camera.position.y+8+Math.random()*30,camera.position.z+(Math.random()-.5)*110);fxDust.spawn(ep,(Math.random()-.5)*2+3,-2-Math.random()*2,(Math.random()-.5)*2,CO.snow,.22+Math.random()*.2,.22,5+Math.random()*3,.85,.2,0)}}
  if(TRK.pal.bubbles&&dt>0){for(let k=0;k<3;k++){ep.set(camera.position.x+(Math.random()-.5)*90,camera.position.y-14+Math.random()*16,camera.position.z+(Math.random()-.5)*90);fxAdd.spawn(ep,(Math.random()-.5)*.6,2+Math.random()*2.5,(Math.random()-.5)*.6,CO.bubble,.18+Math.random()*.25,.3,4+Math.random()*2,.55,.3,-1.5)}}
  if(TRK.pal.motes&&dt>0){for(let k=0;k<2;k++){ep.set(camera.position.x+(Math.random()-.5)*120,camera.position.y-8+Math.random()*30,camera.position.z+(Math.random()-.5)*120);fxAdd.spawn(ep,(Math.random()-.5)*1.5,(Math.random()-.3)*1.2,(Math.random()-.5)*1.5,TRK.pal.moteC?C.setRGB(...TRK.pal.moteC):CO.cyan,.25+Math.random()*.3,.08,3+Math.random()*2,.8,.2)}}
  if((TRK.pal.petals||TRK.pal.leaves)&&dt>0){const lv=TRK.pal.leaves;for(let k=0;k<3;k++){ep.set(camera.position.x+(Math.random()-.5)*120,camera.position.y+2+Math.random()*28,camera.position.z+(Math.random()-.5)*120);
    C.setRGB(...(lv?lv[Math.floor(Math.random()*lv.length)]:TRK.pal.petals));fxDust.spawn(ep,(Math.random()-.5)*3+1.6,-1-Math.random()*1.3,(Math.random()-.5)*3,C,lv?.42+Math.random()*.3:.3+Math.random()*.22,lv?.4:.26,6+Math.random()*3,.92,.25,0)}}
  if(TRK.pal.embers&&dt>0){for(let k=0;k<3;k++){ep.set(camera.position.x+(Math.random()-.5)*140,camera.position.y-20+Math.random()*50,camera.position.z+(Math.random()-.5)*140);fxAdd.spawn(ep,(Math.random()-.5)*3,3+Math.random()*6,(Math.random()-.5)*3,CO.fire,.35+Math.random()*.4,.1,2+Math.random()*1.5,.9,.3)}}
  fxAdd.update(dt);fxDust.update(dt);updateRings(dt);
  updateCamera(dt);
  AU.frame(dt);
  updateDynLights(dt);
  {const fo=player?player.mesh.position:preview?preview.position:null;if(fo&&HQ){sun.position.copy(fo).addScaledVector(SUN,320);sun.target.position.copy(fo)}}
  const sc=renderer.domElement.height/(2*Math.tan(camera.fov*Math.PI/360));fxAdd.mat.uniforms.uScale.value=sc;fxDust.mat.uniforms.uScale.value=sc;
}
let last=performance.now();
function frame(now){requestAnimationFrame(frame);let dt=Math.min(.05,(now-last)/1000);last=now;if(G.paused)dt=0;
  try{update(dt);if(composer)composer.render();else renderer.render(scene,camera);drawSpeedLines()}catch(err){console.error(err)}}
if(!TRACKS[sel.track])sel.track=0;buildTrack(sel.track);renderMenu();setMode(sel.mode);setPreview();titleInit();resize();requestAnimationFrame(frame);
})();
