function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const hash=n=>{const s=Math.sin(n*127.1+311.7)*43758.5453;return s-Math.floor(s)};
const noise1=x=>{const i=Math.floor(x),f=x-i,u=f*f*(3-2*f);return lerp(hash(i),hash(i+1),u)};
const store={get(k,d){try{const v=localStorage.getItem('rift_'+k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem('rift_'+k,JSON.stringify(v))}catch(e){}}};
const $=id=>document.getElementById(id);
const fmt=t=>{if(!isFinite(t))return'--';const m=Math.floor(t/60),s=t-m*60;return m+':'+(s<10?'0':'')+s.toFixed(2)};
const ord=n=>n===1?'st':n===2?'nd':n===3?'rd':'th';

/* ================= renderer / scene ================= */
const canvas=$('gl');
const renderer=new T.WebGLRenderer({canvas,antialias:true,powerPreference:'high-performance'});
const SET_DEF={q:'auto',bloom:true,fx:'high',vMaster:80,vMusic:70,vSfx:85,vEng:85,shake:true,lines:true,tags:true,keys:{left:'KeyA',right:'KeyD',thr:'KeyW',brk:'KeyS',boost:'Space',drift:'ShiftLeft',look:'KeyR'}};
const SET=(()=>{const v=store.get('settings',{});const o=Object.assign({},SET_DEF,v);o.keys=Object.assign({},SET_DEF.keys);return o})();
const IS_TOUCH=('ontouchstart' in window)||navigator.maxTouchPoints>0;
const HQ=SET.q==='high'||(SET.q==='auto'&&!IS_TOUCH);
const pixRatio=()=>Math.min(window.devicePixelRatio||1,SET.q==='low'?1:SET.q==='medium'?1.25:SET.q==='high'?2:HQ?1.75:1.3);
