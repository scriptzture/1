const camera=new T.PerspectiveCamera(70,1,0.3,14000);
const MAXANI=renderer.capabilities.getMaxAnisotropy();

const SUN=new T.Vector3(-0.55,0.24,-0.8).normalize();
const PLANET=new T.Vector3(0.62,0.28,0.73).normalize();
const sky=new T.Mesh(new T.SphereGeometry(10000,32,16),new T.ShaderMaterial({side:T.BackSide,depthWrite:false,
  uniforms:{uSun:{value:SUN},uPlanet:{value:PLANET},uPOn:{value:1},uTop:{value:new T.Vector3()},uMid:{value:new T.Vector3()},uHor:{value:new T.Vector3()},uLow:{value:new T.Vector3()},uCloud:{value:new T.Vector3(1,.9,.8)},uCloudD:{value:.5},uStars:{value:0}},
  vertexShader:'varying vec3 vD;void main(){vD=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}',
  fragmentShader:`uniform vec3 uSun,uPlanet,uTop,uMid,uHor,uLow,uCloud;uniform float uCloudD,uStars,uPOn;varying vec3 vD;
